{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GAIF Tier Classification",
  "description": "Classification of a public AI system per GAIF v1.0 Section 5.1.1",
  "type": "object",
  "required": ["system_name", "vendor", "D", "T", "A", "tier", "justification"],
  "properties": {
    "system_name": {"type": "string"},
    "vendor": {"type": "string"},
    "description": {"type": "string"},
    "D": {"type": "integer", "minimum": 0, "maximum": 2, "description": "Data Control (0=full, 1=third-party, 2=variable)"},
    "T": {"type": "integer", "minimum": 0, "maximum": 2, "description": "Model Transparency (0=full, 1=API-only, 2=partial)"},
    "A": {"type": "integer", "minimum": 0, "maximum": 2, "description": "Autonomy Level (0=invoked, 1=vendor-api, 2=autonomous)"},
    "tier": {"type": "string", "enum": ["Tier A", "Tier B", "Tier C"]},
    "justification": {
      "type": "object",
      "properties": {
        "D_rationale": {"type": "string"},
        "T_rationale": {"type": "string"},
        "A_rationale": {"type": "string"}
      }
    },
    "edge_case_notes": {"type": "string"},
    "last_updated": {"type": "string", "format": "date"},
    "contributor": {"type": "string"}
  }
}
